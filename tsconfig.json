{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    "jsx": "react-jsx",

    // Phase 4: strict mode ON — modules are fully typed
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,

    // allowJs stays true — JarvisCore.jsx is still .jsx
    // checkJs stays false — monolith not type-checked (Phase 5 target)
    "allowJs": true,
    "checkJs": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@styles/*": ["./src/styles/*"],
      "@api/*": ["./api/*"]
    },

    "types": ["vitest/globals"],

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "api"],
  "exclude": ["node_modules", "dist", "src/jarvis/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
