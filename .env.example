# ─── JARVIS EPC v4.26.0 — Environment Variables ──────────────────────────────────
# Copy to .env and fill in all required values before starting.
# NEVER commit .env to version control.

# ─── DATABASE ────────────────────────────────────────────────────────────────────
# Option A: Full connection string (preferred for managed cloud DBs: Neon, Supabase, RDS)
# DATABASE_URL=postgresql://jarvis:password@db.host.com:5432/jarvis_epc?sslmode=require

# Option B: Individual connection fields (used by docker-compose embedded postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jarvis_epc
DB_USER=jarvis
DB_PASSWORD=change-this-strong-password

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=20

# Force SSL for cloud providers (Neon, Supabase, Render, RDS)
DB_SSL=false

# ─── REDIS ───────────────────────────────────────────────────────────────────────
# Used for: JWT token revocation, rate limit cache
# Option A: Managed Redis (Upstash, ElastiCache, Render)
# REDIS_URL=rediss://:password@hostname:6379
# Option B: docker-compose embedded Redis
REDIS_URL=redis://:change-this-redis-password@localhost:6379
REDIS_PASSWORD=change-this-redis-password

# ─── AUTH ────────────────────────────────────────────────────────────────────────
# JWT signing secret — minimum 32 chars. FATAL error in production if missing.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=change-this-to-a-64-char-hex-string-before-deploying

# v4.23 backward compat (single-owner PIN) — no longer required in v4.26 multi-tenant
# OWNER_PIN=legacy-pin-if-needed

# ─── ANTHROPIC AI ────────────────────────────────────────────────────────────────
# Backend-only. NEVER use VITE_ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model for the grounded /ask + agent Q&A path (default: claude-sonnet-4-6).
ASK_MODEL=
# OPTIONAL — point the Anthropic SDK at a self-hosted / OpenAI-compatible model
# behind an Anthropic-compatible proxy (e.g. LiteLLM). Leave blank for Anthropic's
# API. When set, ANTHROPIC_API_KEY is whatever your proxy expects, ASK_MODEL is
# your model name, and add that model to MODEL_COSTS in aiCostTracker.ts so spend
# is priced correctly (otherwise it falls back to the $3/$15-per-M default).
ANTHROPIC_BASE_URL=

# ─── SERVER ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── FILE STORAGE ────────────────────────────────────────────────────────────────
# 'local' — stores in STORAGE_LOCAL_DIR (default: ./uploads). Good for dev + small teams.
# 's3'    — AWS S3 or S3-compatible (MinIO, Cloudflare R2, Tigris). Recommended for production.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
MAX_FILE_SIZE_MB=100

# S3 / S3-compatible (set STORAGE_BACKEND=s3 and fill these in)
# S3_BUCKET=jarvis-epc-files
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# S3-compatible override (MinIO / Cloudflare R2 / Tigris)
# S3_ENDPOINT=https://your-minio-or-r2-endpoint
# S3_FORCE_PATH_STYLE=true   # required for MinIO

# ─── FRONTEND (VITE_ prefix — bundled into browser) ──────────────────────────────
VITE_GATEWAY_MODE=proxied
VITE_BACKEND_URL=http://localhost:3001
VITE_APP_VERSION=4.26.0
VITE_APP_ENV=development

# Feature flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_MAINTENANCE_MODE=false
VITE_ENABLE_DEBUG_PANEL=false

# ─── EXTERNAL LOG DRAIN (optional) ───────────────────────────────────────────────
# LOG_DRAIN_URL=https://api.axiom.co/v1/datasets/your-dataset/ingest
# LOG_DRAIN_TOKEN=your-ingest-token
# LOG_DRAIN_BATCH=20
# LOG_DRAIN_FLUSH_MS=5000

# ─── PRODUCTION SECURITY CHECKLIST ───────────────────────────────────────────────
# [ ] DB_PASSWORD is set to a strong, unique value
# [ ] REDIS_PASSWORD is set to a strong, unique value
# [ ] JWT_SECRET is set to a 64+ char cryptographically random hex string
# [ ] ANTHROPIC_API_KEY is in deployment secrets (not this file)
# [ ] STORAGE_BACKEND=s3 with a dedicated bucket (not local for production)
# [ ] NODE_ENV=production
# [ ] DB_SSL=true for managed cloud PostgreSQL providers
# [ ] REDIS_URL uses rediss:// (TLS) for managed Redis providers
# [ ] ALLOWED_ORIGINS contains only your production domain(s) — no wildcards
# [ ] VITE_ANTHROPIC_API_KEY is NOT set (key must never reach the browser)
# [ ] Ensure database role jarvis_app has ONLY the permissions granted in migrations
# [ ] Run pg_hba.conf to restrict DB access to the API service only
# [ ] Rotate JWT_SECRET periodically and ensure graceful token expiry handling

# ─── COMMISSIONING INTEGRATION (extraction PR-1) ─────────────────────────────
# Denver is the orchestration layer; commissioning EXECUTION runs in a separate
# Commissioning platform. This boundary is OFF by default — with the flag unset,
# the outbound gateway is a no-op and the inbound webhook returns 503.
COMMISSIONING_EXTERNAL=false
# Base URL of the external Commissioning API (no trailing slash). e.g. https://commissioning.example.com
COMMISSIONING_BASE_URL=
# Bearer token Denver presents on outbound calls to Commissioning.
COMMISSIONING_SVC_TOKEN=
# Shared secret used to verify HMAC-SHA256 signatures on inbound webhooks.
COMMISSIONING_WEBHOOK_SECRET=
# Outbound request timeout in milliseconds (default 10s).
COMMISSIONING_TIMEOUT_MS=10000

# ─── NOVA INTEGRATION (ADR-001) ──────────────────────────────────────────────
# Nova (business operations) originates commercial projects; Denver executes
# the linked EPC project and publishes progress/turnover events back. OFF by
# default — with the flag unset, the outbox enqueue is a no-op and the inbound
# command endpoint (/api/nova/commands) returns 503. Contracts:
# docs/integration/nova-denver/contracts/v1/.
NOVA_EXTERNAL=false
# Base URL of the Nova API (no trailing slash), e.g. https://nova.example.com —
# outbound event delivery target (POST {base}/api/integrations/denver/events).
NOVA_BASE_URL=
# Shared secret used to VERIFY HMAC-SHA256 signatures on inbound Nova commands.
NOVA_COMMAND_SECRET=
# Previous command secret, accepted alongside the current one during rotation.
# Leave empty except while rotating.
NOVA_COMMAND_SECRET_PREVIOUS=
# Shared secret Denver uses to SIGN outbound Denver → Nova event webhooks.
NOVA_WEBHOOK_SECRET=
# Previous webhook secret is a RECEIVER-side (Nova) concern during rotation;
# Denver always signs with the current NOVA_WEBHOOK_SECRET only.
NOVA_WEBHOOK_SECRET_PREVIOUS=
# Public URL of this Denver deployment (Nova composes deep links from it).
NOVA_PUBLIC_URL=
# Outbound request timeout in milliseconds (default 10s).
NOVA_TIMEOUT_MS=10000

# ─── AI CAPABILITY REGISTRY (R2) ─────────────────────────────────────────────
# Denver resolves capabilities → specialist providers instead of hardcoding URLs.
# OFF by default: with the flag unset, getProviderFor() returns disabled and the
# existing AVA_MCP_URL bridge is unaffected. Provider base URLs are read live;
# Menlo reuses COMMISSIONING_BASE_URL and Ava reuses AVA_MCP_URL (below).
CAPABILITY_REGISTRY=false
# Crania — MCP front door (process design, calculations, drawing review,
# engineering model). Absorbed the former Ava-Engineering-Core engine (ADR-011).
CRANIA_MCP_URL=
# Crania — REST doc-factory endpoint (EAP document generation; see R7 below).
CRANIA_BASE_URL=
# Ava-ControlCore (PLC/SCADA generation + review).
CONTROLCORE_BASE_URL=

# ─── EAP DOCUMENT FACTORY (R7) ───────────────────────────────────────────────
# Route Denver engineering-doc generation to Crania's EAP (the sole doc authority).
# OFF by default: generateDocument()/exportDocument() are no-ops until enabled.
# Uses CRANIA_BASE_URL (above) for the endpoint.
EAP_ENABLED=false
# Bearer token Denver presents to EAP.
CRANIA_SVC_TOKEN=
# EAP request timeout in milliseconds (default 15s).
EAP_TIMEOUT_MS=15000

# ─── OPENAPI (R6b) ───────────────────────────────────────────────────────────
# Publish the OpenAPI document at GET /openapi.json (public, like /metrics).
# OFF by default: the endpoint returns 404 until enabled.
OPENAPI_ENABLED=false

# ─── IDEMPOTENCY (R6a) ───────────────────────────────────────────────────────
# Replays the stored response for a repeated mutating request with the same
# Idempotency-Key header. OFF by default (strict pass-through); also opt-in per
# request (only acts when the client sends the header). Not auto-mounted yet.
IDEMPOTENCY=false
# Cache entry lifetime in milliseconds (default 24h).
IDEMPOTENCY_TTL_MS=86400000

# ─── DENVER MCP SERVER (R6c) ─────────────────────────────────────────────────
# Provider-side MCP: exposes Denver capabilities as tools other systems can call
# (distinct from the AVA_MCP_URL consumer bridge). OFF by default; the route is
# not mounted yet (needs a service-to-service auth decision).
DENVER_MCP_SERVER=false

# ─── PERSONAL AGENT (ADR-012, Phase 1) ───────────────────────────────────────
# Per-user assistant: personal (user-scoped) memory + a My-Work briefing +
# knowledge Q&A on the user's behalf, under /api/v1/me/agent/*. Read-only — no
# autonomous actions. OFF by default: the whole route surface returns 404 until
# enabled. The `ask` endpoint additionally needs ANTHROPIC_API_KEY.
PERSONAL_AGENT=false

# ─── KNOWLEDGE GRAPH (R5) ────────────────────────────────────────────────────
# Reserved for future auto-contribution wiring (apps emitting graph edges on
# events). The graph + digital-thread helpers are pure and usable regardless.
KNOWLEDGE_GRAPH=false

# ─── UNIVERSAL EVENTS (R3) ───────────────────────────────────────────────────
# Denver publishes canonical dotted events (project.created, fat.completed, …)
# over the existing webhook dispatcher (+ realtime mirror for UI-relevant ones).
# OFF by default: publishEvent() builds/validates the envelope but does not fan
# out, so no existing behavior changes until enabled.
UNIVERSAL_EVENTS=false

# ─── UNIVERSAL OBJECT REGISTRY (R4) ──────────────────────────────────────────
# Reserved for future registry enforcement in business flows. The minting/
# reference helpers are pure and always usable; this flag gates wiring refs into
# request paths. OFF by default.
OBJECT_REGISTRY=false

# ─── AVA MCP BRIDGE (v4.28.0) ────────────────────────────────────────────────
# URL of the Ava FastMCP server. Leave empty to use native tools only.
# Example: http://localhost:8788  or  http://ava-host:8788
AVA_MCP_URL=

# Proxy timeout in milliseconds for Ava tool calls (default 15s)
AVA_MCP_TIMEOUT_MS=15000

# Comma-separated domains the http_fetch tool may contact. Empty = open in dev.
# Example: api.weather.gov,data.epa.gov
MCP_FETCH_ALLOWLIST=
