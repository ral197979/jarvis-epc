# ─── JARVIS EPC v4.26.0 — API Dockerfile ────────────────────────────────────
# Multi-stage: build → production (minimal runtime image)

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Install deps first (layer cache)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy source
COPY tsconfig*.json ./
COPY api/ ./api/
COPY src/modules/ ./src/modules/

# Compile TypeScript
RUN npx tsc -p tsconfig.json --outDir dist --noEmit false || true
# Fallback: use tsx at runtime (acceptable for small teams)

# Stage 2: Production runtime
FROM node:20-alpine AS runtime
WORKDIR /app

# Security: run as non-root
RUN addgroup -S jarvis && adduser -S jarvis -G jarvis

# Production deps only
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Copy built app
COPY --from=builder /app/api ./api
COPY --from=builder /app/src ./src

# Upload directory (used when STORAGE_BACKEND=local)
RUN mkdir -p /app/uploads && chown jarvis:jarvis /app/uploads

USER jarvis

EXPOSE 3001

# Health check (matches docker-compose)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:3001/api/v1/health || exit 1

# Use tsx for TypeScript execution (no separate build step needed)
CMD ["npx", "tsx", "api/server.ts"]
