{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Stricter rules than root tsconfig — modules must be fully typed
    "noUnusedLocals":      true,
    "noUnusedParameters":  false,
    "noImplicitOverride":  true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes":         false,
    "noUncheckedIndexedAccess":           false,

    // No allowJs here — modules must be pure TypeScript
    "allowJs":  false,
    "checkJs":  false,

    // Ensure modules don't accidentally import from the monolith
    "paths": {
      "@/*":        ["./src/*"],
      "@modules/*": ["./src/modules/*"]
    }
  },
  "include": [
    "src/modules/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/jarvis/**",
    "src/**/*.test.ts",
    "api/**/*.test.ts",
    "e2e/**"
  ]
}
