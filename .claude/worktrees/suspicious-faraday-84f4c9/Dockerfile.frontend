# ─── JARVIS EPC v4.26.0 — Frontend Dockerfile ───────────────────────────────
# Multi-stage: Vite build → nginx serve

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Accept build args (passed from docker-compose)
ARG VITE_BACKEND_URL=http://localhost:3001
ARG VITE_GATEWAY_MODE=proxied
ARG VITE_APP_VERSION=4.26.0
ARG VITE_APP_ENV=production
ARG VITE_ENABLE_AI_CHAT=true
ARG VITE_ENABLE_MAINTENANCE_MODE=false
ARG VITE_ENABLE_DEBUG_PANEL=false

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_GATEWAY_MODE=$VITE_GATEWAY_MODE
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_APP_ENV=$VITE_APP_ENV
ENV VITE_ENABLE_AI_CHAT=$VITE_ENABLE_AI_CHAT
ENV VITE_ENABLE_MAINTENANCE_MODE=$VITE_ENABLE_MAINTENANCE_MODE
ENV VITE_ENABLE_DEBUG_PANEL=$VITE_ENABLE_DEBUG_PANEL

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

# Stage 2: nginx serving
FROM nginx:1.27-alpine AS runtime

# Copy SPA build
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config — SPA routing (all paths → index.html) + security headers
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
