{
  "name": "denver-engineering",
  "version": "4.31.0",
  "private": true,
  "description": "Denver Engineering v4.26.0 — Production-Ready AI-powered Engineering, Procurement & Construction Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src api --max-warnings 0",
    "api:dev": "tsx watch api/server.ts",
    "api:start": "tsx api/server.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "dev:full": "concurrently \"npm run dev\" \"npm run api:dev\"",
    "typecheck:modules": "tsc --project tsconfig.modules.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:modules",
    "check:monolith": "node scripts/check-monolith-size.js",
    "ci": "npm audit --audit-level=high && npm run typecheck:all && npm run check:monolith && npm test -- --run",
    "db:migrate": "tsx api/db/migrate.ts",
    "knowledge:ingest": "tsx api/scripts/ingest-directory.ts",
    "ops:health": "tsx scripts/ops-health-snapshot.ts",
    "ops:governance": "tsx scripts/ops-governance-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.11.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.8.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "web-ifc": "^0.0.77",
    "ws": "^8.18.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest-axe": "^3.5.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.9",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
